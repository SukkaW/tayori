{
  "name": "tayori-monorepo",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SukkaW/tayori.git"
  },
  "scripts": {
    "build": "pnpm -r --filter tayori-core --filter tayori --filter tayori-connect run build",
    "test": "pnpm -r run test",
    "lint": "eslint --format=sukka .",
    "typecheck": "tsc --build --noEmit",
    "example:dev": "pnpm --filter example-nextjs-app dev",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "prerelease": "pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run test",
    "release": "bumpp packages/tayori-core/package.json packages/tayori/package.json packages/tayori-connect/package.json --install --commit \"release: %s\" --tag \"%s\""
  },
  "devDependencies": {
    "@eslint-sukka/react": "^9.1.0",
    "@eslint-sukka/shared": "^9.1.0",
    "bumpp": "^10.4.1",
    "eslint": "^10.10.0",
    "eslint-config-sukka": "^9.1.0",
    "eslint-formatter-sukka": "^9.1.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.27.0"
}
