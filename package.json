{
  "name": "tayori-monorepo",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SukkaW/tayori.git"
  },
  "scripts": {
    "build": "turbo run build --filter=tayori-core --filter=tayori --filter=tayori-connect",
    "generate": "turbo run generate",
    "test": "turbo run test",
    "lint": "turbo run build generate --filter=tayori-core --filter=tayori --filter=tayori-connect && eslint --format=sukka .",
    "typecheck": "turbo run typecheck",
    "example:dev": "pnpm --filter example-nextjs-app dev",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "prerelease": "pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run test",
    "release": "bumpp packages/tayori-core/package.json packages/tayori/package.json packages/tayori-connect/package.json --install --commit \"release: %s\" --tag \"%s\""
  },
  "devDependencies": {
    "@eslint-sukka/react": "^9.1.0",
    "@eslint-sukka/shared": "^9.1.0",
    "@happy-dom/global-registrator": "^20.14.5",
    "bumpp": "^10.4.1",
    "eslint": "^10.12.0",
    "eslint-config-sukka": "^9.1.0",
    "eslint-formatter-sukka": "^9.1.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "swr": "^2.6.0-beta.0",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.28.5"
}
