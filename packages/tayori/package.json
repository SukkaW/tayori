{
  "name": "tayori",
  "version": "0.3.8",
  "description": "An opinionated React client-side data fetching stack built with Ky, SWR, Zod and Hey API",
  "repository": {
    "type": "git",
    "url": "https://github.com/SukkaW/tayori",
    "directory": "packages/tayori"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bunchee --minify --no-sourcemap",
    "lint": "eslint --format=sukka .",
    "test": "SWC_NODE_IGNORE_DYNAMIC=1 SWC_NODE_INLINE_SOURCE_MAP=1 nyc mocha"
  },
  "keywords": [
    "SWR",
    "Hey API",
    "React",
    "OpenAPI",
    "TypeScript"
  ],
  "author": "Sukka <https://skk.moe>",
  "license": "MIT",
  "dependencies": {
    "tayori-core": "workspace:^"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.13",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sinon": "^22.0.0",
    "bunchee": "^6.12.2",
    "earl": "^2.0.0",
    "happy-dom": "^20.14.5",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sinon": "^22.1.0",
    "swr": "^2.5.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "react": ">=19.2.0",
    "swr": "^2.4.0"
  }
}
